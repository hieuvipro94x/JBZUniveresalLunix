<Window x:Class="JBZUniveresalLunix.Views.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:views="clr-namespace:JBZUniveresalLunix.Views"
        Title="UniversalTester - Man hinh kiem tra"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F7F7F5"
        FontFamily="Malgun Gothic"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="TestWindow_Loaded"
        SizeChanged="TestWindow_SizeChanged"
        Closing="TestWindow_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="PiBgBrush" Color="#F7F7F5"/>
        <SolidColorBrush x:Key="PiPanelBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PiFieldBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PiHeaderBrush" Color="#F4F4F2"/>
        <SolidColorBrush x:Key="PiBorderBrush" Color="#CFCFCF"/>
        <SolidColorBrush x:Key="PiGridBrush" Color="#D6D6D6"/>
        <SolidColorBrush x:Key="PiValueBorderBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="PiIndustrialTextBrush" Color="#333333"/>
        <SolidColorBrush x:Key="PiTextBrush" Color="#555555"/>
        <SolidColorBrush x:Key="PiDarkTextBrush" Color="#333333"/>
        <SolidColorBrush x:Key="PiPassBrush" Color="#2AA84A"/>
        <SolidColorBrush x:Key="PiFailBrush" Color="#C62828"/>
        <SolidColorBrush x:Key="PiRunningBrush" Color="#A135A4"/>
        <SolidColorBrush x:Key="PiWarningBrush" Color="#E09B27"/>
        <SolidColorBrush x:Key="PiProbeBrush" Color="#23D9D9"/>
        <SolidColorBrush x:Key="PiProbeButtonBrush" Color="#78D878"/>
        <SolidColorBrush x:Key="PiButtonBrush" Color="#ECECEC"/>
        <SolidColorBrush x:Key="PiBlueTextBrush" Color="#0026D9"/>
        <SolidColorBrush x:Key="PiStopButtonBrush" Color="#F1B8B8"/>
        <SolidColorBrush x:Key="PiMaintenanceButtonBrush" Color="#F6D38B"/>
        <SolidColorBrush x:Key="LabelRetryBackground" Color="#FFF4E5"/>
        <SolidColorBrush x:Key="LabelRetryForeground" Color="#8A4B08"/>
        <SolidColorBrush x:Key="LabelRetryBorder" Color="#D9A441"/>
        <SolidColorBrush x:Key="LabelReprintBackground" Color="#E5F5F3"/>
        <SolidColorBrush x:Key="LabelReprintForeground" Color="#0F766E"/>
        <SolidColorBrush x:Key="LabelReprintBorder" Color="#86C8C1"/>
        <SolidColorBrush x:Key="TestExitBackground" Color="#FFF0F0"/>
        <SolidColorBrush x:Key="TestExitForeground" Color="#A61B1B"/>
        <SolidColorBrush x:Key="TestExitBorder" Color="#D97979"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <sys:Double x:Key="TestGridBaseFontSize">18</sys:Double>
        <sys:Double x:Key="TestFaultGridFontSize">22</sys:Double>
        <sys:Double x:Key="TestGridHeaderFontSize">18</sys:Double>
        <sys:Double x:Key="TestFaultGridHeaderFontSize">20</sys:Double>
        <sys:Double x:Key="TestGridRowHeight">34</sys:Double>
        <sys:Double x:Key="TestGridColumnHeaderHeight">40</sys:Double>

        <Style x:Key="PiButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{StaticResource PiButtonBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TestSemanticButtonBase"
               TargetType="Button"
               BasedOn="{StaticResource PiButtonStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Border x:Name="InteractionOverlay"
                                    Background="#000000"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Opacity="0"/>
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.08"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.16"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E5E7EB"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelRetryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TestSemanticButtonBase}">
            <Setter Property="Background" Value="{StaticResource LabelRetryBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource LabelRetryForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LabelRetryBorder}"/>
        </Style>

        <Style x:Key="LabelReprintButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TestSemanticButtonBase}">
            <Setter Property="Background" Value="{StaticResource LabelReprintBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource LabelReprintForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LabelReprintBorder}"/>
        </Style>

        <Style x:Key="TestExitButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TestSemanticButtonBase}">
            <Setter Property="Background" Value="{StaticResource TestExitBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TestExitForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TestExitBorder}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="IndustrialLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="PiLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource IndustrialLabelStyle}"/>

        <Style x:Key="IndustrialCounterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource IndustrialLabelStyle}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <Style x:Key="ProductRightLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource IndustrialLabelStyle}">
            <Setter Property="Margin" Value="10,0,6,0"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <Style x:Key="IndustrialValueStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="{StaticResource PiFieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiValueBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="PiFieldStyle" TargetType="TextBox" BasedOn="{StaticResource IndustrialValueStyle}"/>

        <Style x:Key="IndustrialCounterValueStyle" TargetType="TextBox" BasedOn="{StaticResource IndustrialValueStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Width" Value="Auto"/>
        </Style>

        <Style x:Key="PiCounterFieldStyle" TargetType="TextBox" BasedOn="{StaticResource IndustrialCounterValueStyle}"/>

        <Style x:Key="RightCounterFieldStyle" TargetType="TextBox" BasedOn="{StaticResource IndustrialCounterValueStyle}">
            <Setter Property="Width" Value="118"/>
        </Style>

        <Style x:Key="PiCounterValueBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource PiFieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiValueBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PiCounterTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="PiGridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="{DynamicResource TestGridBaseFontSize}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLiveTopologyPresentation}" Value="True">
                    <Setter Property="Foreground" Value="#FF0000"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PiGridStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PiGridTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="HtdrvGridTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PiGridTextStyle}">
            <Setter Property="FontSize" Value="{DynamicResource TestFaultGridFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="HtdrvGridStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HtdrvGridTextStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="HtdrvGridCenterTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HtdrvGridTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HtdrvGridStrongCenterTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HtdrvGridCenterTextStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Cột IO phải luôn hiện đầy đủ, ví dụ IO (12) / IO (256), không rút gọn thành IO... -->
        <Style x:Key="HtdrvIoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HtdrvGridStrongCenterTextStyle}">
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <!-- Nhấn mạnh ba thông tin công nhân cần nhận dạng nhanh trên bảng test. -->
        <Style x:Key="OperatorWireTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource HtdrvGridCenterTextStyle}">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PiBlueTextBrush}"/>
        </Style>

        <Style x:Key="OperatorConnectorTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource OperatorWireTextStyle}">
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <Style x:Key="OperatorStatusTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource HtdrvGridStrongTextStyle}">
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <Style x:Key="PiGridCenterTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PiGridTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PiGridResultTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PiGridCenterTextStyle}">
            <Setter Property="FontWeight" Value="Medium"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResultText}" Value="FAIL">
                    <Setter Property="Foreground" Value="{StaticResource PiFailBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndustrialGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PiHeaderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PiIndustrialTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiGridBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="{DynamicResource TestGridHeaderFontSize}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>

        <Style x:Key="HtdrvGridHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource IndustrialGridHeaderStyle}">
            <Setter Property="FontSize" Value="{DynamicResource TestFaultGridHeaderFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PiFaultGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PiGridBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource PiGridBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="RowHeight" Value="{DynamicResource TestGridRowHeight}"/>
            <Setter Property="ColumnHeaderHeight" Value="{DynamicResource TestGridColumnHeaderHeight}"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="{DynamicResource TestGridBaseFontSize}"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource IndustrialGridHeaderStyle}"/>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{Binding RowForegroundBrush}"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNetworkStart}" Value="True">
                                <Setter Property="BorderBrush" Value="#23E6E6"/>
                                <Setter Property="BorderThickness" Value="0,8,0,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Open">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="MissingConnection">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="WrongWiring">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Short">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding KindName}" Value="Probe">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{Binding RowForegroundBrush}"/>
                            </Trigger>
                            <!-- LiveTopology (mã hàng không cấu hình IO): chỉ đổi màu hiển thị,
                                 tuyệt đối không đổi FaultKind/ProductFaultType nên không cộng lỗi. -->
                            <DataTrigger Binding="{Binding IsLiveTopologyPresentation}" Value="True">
                                <Setter Property="Foreground" Value="#FF0000"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FaultOperationGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource PiFaultGridStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedOperationTabIndex}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResistanceOperationGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource PiFaultGridStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedOperationTabIndex}" Value="1">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndustrialGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding RowForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PiGridBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{Binding RowForegroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PiGridBrush}"/>
                </Trigger>
                <!-- LiveTopology: DataGridCell đang đặt Foreground riêng nên phải
                     đổi màu ngay tại Cell; đổi ở DataGridRow thôi sẽ bị ghi đè. -->
                <DataTrigger Binding="{Binding IsLiveTopologyPresentation}" Value="True">
                    <Setter Property="Foreground" Value="#FF0000"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PiCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource IndustrialGridCellStyle}"/>

        <Style x:Key="PiCenterCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource IndustrialGridCellStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PassFailResultCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource PiCenterCellStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResultText}" Value="PASS">
                    <Setter Property="Background" Value="{StaticResource PiPassBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultText}" Value="FAIL">
                    <Setter Property="Background" Value="{StaticResource PiFailBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="WireColorCellTemplate">
            <Border HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Mặc định vẫn dùng màu do ViewModel cung cấp. -->
                        <Setter Property="Background" Value="{Binding WireColorBrush}"/>
                        <Style.Triggers>
                            <!-- Mã màu dây Orange: O / Or / OR phải luôn hiển thị màu cam,
                                 không được rơi về màu xanh dương do mapping/fallback cũ. -->
                            <DataTrigger Binding="{Binding WireColorText}" Value="O">
                                <Setter Property="Background" Value="#FF8C00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WireColorText}" Value="o">
                                <Setter Property="Background" Value="#FF8C00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WireColorText}" Value="Or">
                                <Setter Property="Background" Value="#FF8C00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WireColorText}" Value="OR">
                                <Setter Property="Background" Value="#FF8C00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WireColorText}" Value="or">
                                <Setter Property="Background" Value="#FF8C00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WireColorText}" Value="Orange">
                                <Setter Property="Background" Value="#FF8C00"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WireColorText}" Value="ORANGE">
                                <Setter Property="Background" Value="#FF8C00"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <views:OutlinedTextBlock Text="{Binding WireColorText}"
                                         Foreground="White"
                                         Stroke="#111111"
                                         StrokeThickness="1"
                                         FontFamily="Malgun Gothic"
                                         FontSize="22"
                                         FontWeight="Bold"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource PiBgBrush}"
          Margin="8,8,8,0"
          ClipToBounds="False"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0"
                 Margin="0,0,0,6"
                 Stretch="Uniform"
                 StretchDirection="DownOnly"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top">
        <Grid x:Name="TestHeaderSurface" Width="1344" Height="234">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="500"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <Grid x:Name="HeaderNavigationRow" Height="38">
                    <Button Content="TRANG CH&#205;NH"
                            Click="BackToMain_Click"
                            Style="{StaticResource TestExitButtonStyle}"
                            Width="160"
                            HorizontalAlignment="Left"/>
                </Grid>
                <Grid x:Name="LabelActionButtonsPanel" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="TH&#7916; L&#7840;I IN TEM"
                            Command="{Binding RetryLabelCommand}"
                            Style="{StaticResource LabelRetryButtonStyle}"
                            Height="30"
                            FontSize="9.5"
                            ToolTip="Ch&#7881; th&#7917; l&#7841;i l&#7847;n in &#273;&#7847;u &#273;&#227; th&#7845;t b&#7841;i; th&#224;nh c&#244;ng s&#7869; ho&#224;n t&#7845;t giao d&#7883;ch LOT."/>
                    <Button Grid.Column="2"
                            Content="IN TH&#202;M B&#7842;N SAO"
                            Command="{Binding ReprintLabelCommand}"
                            Style="{StaticResource LabelReprintButtonStyle}"
                            Height="30"
                            FontSize="9.5"
                            ToolTip="In th&#234;m b&#7843;n sao c&#7911;a tem &#273;&#227; in th&#224;nh c&#244;ng; kh&#244;ng t&#259;ng LOT v&#224; c&#243; ghi l&#7883;ch s&#7917; reprint."/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132"/>
                        <ColumnDefinition Width="96"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="S&#7889; LOT" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Column="1" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Lot, Mode=OneWay}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="S&#7889; l&#7895;i h&#7903; m&#7841;ch" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding OpenCount, Mode=OneWay}" Foreground="{StaticResource PiFailBrush}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="S&#7889; l&#7895;i &#273;&#7845;u sai" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding WrongCountText, Mode=OneWay}" Foreground="{StaticResource PiFailBrush}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="3" Text="S&#7889; l&#7895;i" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Fail, Mode=OneWay}" Foreground="{StaticResource PiBlueTextBrush}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                </Grid>
            </StackPanel>

            <Grid Grid.Column="1" Margin="8,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="92"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="194"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0"
                             Margin="4"
                             Stretch="Uniform"
                             StretchDirection="DownOnly">
                        <TextBlock x:Name="ModelTitleText"
                                   Text="{Binding ModelName, Mode=OneWay}"
                                   ToolTip="{Binding ModelName, Mode=OneWay}"
                                   Foreground="{StaticResource PiIndustrialTextBrush}"
                                   FontSize="31"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="NoWrap"/>
                    </Viewbox>

                    <Border Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Margin="0,2,2,0"
                            Padding="8,6"
                            Background="#FFF7D6"
                            BorderBrush="#B68A00"
                            BorderThickness="2"
                            CornerRadius="4">
                        <TextBlock x:Name="CurrentTimeText"
                                   Foreground="#1E293B"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Grid.RowSpan="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="M&#227; s&#7843;n ph&#7849;m" Style="{StaticResource PiLabelStyle}"/>
                    <TextBox Grid.Column="1" Text="{Binding PartNumber, Mode=OneWay}" ToolTip="{Binding PartNumber, Mode=OneWay}" Style="{StaticResource PiFieldStyle}"/>
                    <TextBlock Grid.Column="2" Text="Lo&#7841;i xe" Style="{StaticResource ProductRightLabelStyle}"/>
                    <TextBox Grid.Column="3" Text="{Binding VehicleType, Mode=OneWay}" ToolTip="{Binding VehicleType, Mode=OneWay}" Style="{StaticResource PiFieldStyle}"/>

                    <Grid Grid.Row="1">
                        <TextBlock Text="T&#234;n s&#7843;n ph&#7849;m"
                                   Style="{StaticResource PiLabelStyle}"
                                   VerticalAlignment="Top"/>
                    </Grid>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProductName, Mode=OneWay}" ToolTip="{Binding ProductName, Mode=OneWay}" Style="{StaticResource PiFieldStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="M&#227; kh&#225;ch h&#224;ng" Style="{StaticResource ProductRightLabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding CustomerCode, Mode=OneWay}" ToolTip="{Binding CustomerCode, Mode=OneWay}" Style="{StaticResource PiFieldStyle}"/>
                </Grid>
            </Grid>

            <Border Grid.Column="2"
                    Width="294"
                    Height="92"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top"
                    Background="{Binding WaterProofCardBackground}"
                    BorderBrush="{Binding WaterProofAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    ToolTip="{Binding WaterProofStageText}"
                    SnapsToDevicePixels="True"
                    Visibility="{Binding IsWaterProofCardVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="4" Height="18" Margin="0,0,8,0"
                                Background="{Binding WaterProofAccentBrush}"
                                CornerRadius="2"/>
                        <TextBlock Grid.Column="1"
                                   Text="ĐỘ RÒ RỈ"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#102A43"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding WaterProofStageText}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#486581"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="112"/>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding WaterProofChannels}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="92"
                                        Height="50"
                                        Margin="2,0"
                                        Background="{Binding LiveCellBackground}"
                                        BorderBrush="#B8C7D9"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding ChannelText}"
                                                   Foreground="{Binding LiveCellForeground}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="84"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding LiveMachineValueText}"
                                                   Foreground="{Binding LiveCellForeground}"
                                                   FontSize="19"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Grid Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="150"
                        VerticalAlignment="Top"
                        Background="{Binding StateBackground}"
                        BorderBrush="{StaticResource PiBorderBrush}"
                        BorderThickness="1">
                    <TextBlock Text="{Binding ResultStatusText}"
                               Margin="8,6"
                               Foreground="{Binding StateForeground}"
                               FontSize="32"
                               FontWeight="Bold"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="38"/>
                </Border>

                <Grid Grid.Column="2" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="118"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="39"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="39"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="39"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="2"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="T&#7893;ng s&#7889;" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Column="2" Width="118" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Total, Mode=OneWay}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="S&#7889; &#273;&#7841;t" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="2" Grid.Column="2" Width="118" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Pass, Mode=OneWay}" Foreground="{StaticResource PiPassBrush}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="4" Text="S&#7889; l&#7895;i" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="4" Grid.Column="2" Width="118" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Fail, Mode=OneWay}" Foreground="{StaticResource PiFailBrush}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock Grid.Row="6" Text="T&#7927; l&#7879;" Style="{StaticResource IndustrialCounterLabelStyle}"/>
                    <Border Grid.Row="6" Grid.Column="2" Width="118" Style="{StaticResource PiCounterValueBorderStyle}">
                        <TextBlock Text="{Binding Rate, Mode=OneWay, StringFormat={}{0:0.00} %}" Style="{StaticResource PiCounterTextStyle}"/>
                    </Border>
                    <TextBlock x:Name="TestAppVersionText"
                               Grid.Row="8"
                               Grid.Column="2"
                               Width="118"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#6B7280"/>

                    <!-- Chu kỳ Probe Pin: căn đều, không cắt chữ, RESET là Button màu vàng cam. -->
                    <Grid Grid.Row="10"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1"
                                   Text="CHU KỲ THAY PIN:"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   FontFamily="Malgun Gothic"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#111111"
                                   TextWrapping="NoWrap"
                                   TextTrimming="None"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding ProbeCycleText, Mode=OneWay}"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontFamily="Malgun Gothic"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#111111"
                                   TextWrapping="NoWrap"
                                   TextTrimming="None"/>

                        <Button Grid.Column="3"
                                Click="ResetProbeCounter_Click"
                                Width="52"
                                Height="24"
                                Padding="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="RESET CHU KỲ THAY PIN">
                                <Image Source="pack://application:,,,/JBZUniveresalLunix;component/Assets/reset_probe_cycle.png"
                                   Width="22"
                                   Height="22"
                                   Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        </Viewbox>

        <!-- Universal Tester New: the wire table is the primary live presentation.
             No large center overlay is allowed to cover LẮP SẢN PHẨM/PASS over the rows. -->
        <Grid x:Name="OperationTablesHost" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="0" ItemsSource="{Binding ProbeContacts}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None"
                      MaxHeight="165" MinHeight="0" Margin="0,0,0,4">
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource PiFaultGridStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasInlineProbeContacts}" Value="True"/>
                                    <Condition Binding="{Binding SelectedOperationTabIndex}" Value="0"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="IO" Binding="{Binding IoText}" Width="90"/>
                    <DataGridTextColumn Header="Giắc" Binding="{Binding Connector}" Width="*"/>
                    <DataGridTextColumn Header="Chân" Binding="{Binding Pin}" Width="90"/>
                    <DataGridTextColumn Header="Dây" Binding="{Binding WireName}" Width="*"/>
                    <DataGridTextColumn Header="Dập nối" Binding="{Binding Splice}" Width="*"/>
                    <DataGridTextColumn Header="Tiết diện" Binding="{Binding Section}" Width="95"/>
                    <DataGridTextColumn Header="Màu" Binding="{Binding Color}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="FaultGrid" Grid.Row="1"
                      ItemsSource="{Binding Faults}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ColumnHeaderStyle="{StaticResource HtdrvGridHeaderStyle}"
                      Style="{StaticResource FaultOperationGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lo&#7841;i" Binding="{Binding FaultType}" Width="1.20*" MinWidth="105" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCellStyle}" ElementStyle="{StaticResource HtdrvGridStrongTextStyle}"/>
                    <DataGridTextColumn Header="IO" Binding="{Binding IoText}" Width="0.80*" MinWidth="100" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource HtdrvIoTextStyle}"/>
                    <DataGridTextColumn x:Name="ConnectorColumn" Header="Connector" Binding="{Binding Connector}" Width="0.95*" MinWidth="125" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource OperatorConnectorTextStyle}"/>
                    <DataGridTextColumn Header="Chân Pin" Binding="{Binding Pin}" Width="0.90*" MinWidth="105" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource HtdrvGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="Mã Dây" Binding="{Binding WireName}" Width="1.25*" MinWidth="100" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource OperatorWireTextStyle}"/>
                    <DataGridTemplateColumn Header="M&#224;u" Width="0.85*" MinWidth="90" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCenterCellStyle}" CellTemplate="{StaticResource WireColorCellTemplate}"/>
                    <DataGridTextColumn Header="Tiết Diện" Binding="{Binding Section}" Width="0.85*" MinWidth="90" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource HtdrvGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="Tr&#7841;ng th&#225;i" Binding="{Binding Status}" Width="1.30*" MinWidth="125" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCellStyle}" ElementStyle="{StaticResource OperatorStatusTextStyle}"/>
                    <DataGridTextColumn Header="CẶP KẾT NỐI" Binding="{Binding ConnectionPairText}" Width="1.35*" MinWidth="145" CanUserSort="False" CanUserReorder="False" CanUserResize="False" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource HtdrvGridStrongCenterTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="ResistanceGrid" Grid.Row="1"
                      ItemsSource="{Binding ResistanceDisplayRows}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Style="{StaticResource ResistanceOperationGridStyle}"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="LO&#7840;I" Binding="{Binding Name}" Width="2*" CellStyle="{StaticResource PiCellStyle}" ElementStyle="{StaticResource PiGridTextStyle}"/>
                    <DataGridTextColumn Header="K&#202;NH" Binding="{Binding ChannelText}" Width="1*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="MIN" Binding="{Binding MinDisplayText}" Width="1.5*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="GI&#193; TR&#7882;" Binding="{Binding Display}" Width="2.5*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="MAX" Binding="{Binding MaxDisplayText}" Width="1.5*" CellStyle="{StaticResource PiCenterCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                    <DataGridTextColumn Header="K&#7870;T QU&#7842;" Binding="{Binding ResultText}" Width="1.5*" CellStyle="{StaticResource PassFailResultCellStyle}" ElementStyle="{StaticResource PiGridCenterTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </Grid>
</Window>
