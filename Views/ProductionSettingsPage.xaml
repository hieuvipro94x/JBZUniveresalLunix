<UserControl x:Class="JBZUniveresalLunix.Views.ProductionSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White"
             FontFamily="Segoe UI"
             SizeChanged="Page_SizeChanged">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="FieldBackground" Color="#F8F8F6"/>
        <SolidColorBrush x:Key="HeaderBackground" Color="#EEEEEA"/>
        <SolidColorBrush x:Key="BorderColor" Color="#C7C7C2"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#333333"/>
        <SolidColorBrush x:Key="TextMuted" Color="#555555"/>
        <SolidColorBrush x:Key="BrandBlue" Color="#273F91"/>
        <SolidColorBrush x:Key="PassGreen" Color="#2AA84A"/>
        <SolidColorBrush x:Key="FailRed" Color="#D9363E"/>
        <SolidColorBrush x:Key="PendingAmber" Color="#D88400"/>
        <SolidColorBrush x:Key="ButtonNeutralBackground" Color="#ECEFF1"/>
        <SolidColorBrush x:Key="ButtonNeutralForeground" Color="#455A64"/>
        <SolidColorBrush x:Key="ButtonNeutralBorder" Color="#B0BEC5"/>
        <SolidColorBrush x:Key="ButtonInfoBackground" Color="#E8EDF5"/>
        <SolidColorBrush x:Key="ButtonInfoBorder" Color="#AEBBD2"/>
        <SolidColorBrush x:Key="ButtonActionTeal" Color="#0F766E"/>
        <SolidColorBrush x:Key="ButtonWarningBackground" Color="#FFF4E5"/>
        <SolidColorBrush x:Key="ButtonWarningForeground" Color="#8A4B08"/>
        <SolidColorBrush x:Key="ButtonWarningBorder" Color="#D9A441"/>
        <SolidColorBrush x:Key="ButtonExitBackground" Color="#FFF0F0"/>
        <SolidColorBrush x:Key="ButtonExitForeground" Color="#A61B1B"/>
        <SolidColorBrush x:Key="ButtonExitBorder" Color="#D97979"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
            <Setter Property="Background" Value="{StaticResource HeaderBackground}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource FieldBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="Background" Value="{StaticResource FieldBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="SettingsButtonBase" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource ButtonNeutralBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ButtonNeutralForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonNeutralBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Border x:Name="InteractionOverlay"
                                    Background="#000000"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Opacity="0"/>
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.08"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.16"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E5E7EB"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource SettingsButtonBase}"/>

        <Style x:Key="SettingsPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SettingsButtonBase}">
            <Setter Property="Background" Value="{StaticResource BrandBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E3278"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SettingsInfoButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SettingsButtonBase}">
            <Setter Property="Background" Value="{StaticResource ButtonInfoBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonInfoBorder}"/>
        </Style>

        <Style x:Key="SettingsActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SettingsButtonBase}">
            <Setter Property="Background" Value="{StaticResource ButtonActionTeal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0B5F59"/>
        </Style>

        <Style x:Key="SettingsWarningButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SettingsButtonBase}">
            <Setter Property="Background" Value="{StaticResource ButtonWarningBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ButtonWarningForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonWarningBorder}"/>
        </Style>

        <Style x:Key="SettingsExitButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SettingsButtonBase}">
            <Setter Property="Background" Value="{StaticResource ButtonExitBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ButtonExitForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonExitBorder}"/>
        </Style>

        <Style x:Key="SettingsPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <Style x:Key="MiniHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="10,5">
                <Button Width="138" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Content="TRANG CH&#205;NH" Click="Cancel_Click"
                        Style="{StaticResource SettingsExitButtonStyle}"/>
                <TextBlock Text="C&#192;I &#272;&#7862;T PRODUCTION"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrandBlue}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      x:Name="SettingsScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      ScrollChanged="SettingsScrollViewer_ScrollChanged">
        <WrapPanel x:Name="SettingsPanelsHost" Margin="4" Orientation="Horizontal">

            <Border x:Name="IoSettingsPanel" Width="370" VerticalAlignment="Top" Style="{StaticResource SettingsPanelStyle}">
                <StackPanel>
                    <TextBlock Text="I/O / PRODUCTION" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Card m&#7903; r&#7897;ng" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CardIoComboBox"
                                  Grid.Column="1"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="ExpansionCardCount"
                                  SelectedValue="{Binding Settings.ExpansionCardCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="CardIoComboBox_SelectionChanged"
                                  ToolTip="S&#7889; card m&#7903; r&#7897;ng 64 IO; START_SCAN d&#249;ng c&#249;ng &#273;&#417;n v&#7883;"/>

                        <TextBlock Grid.Row="1" Text="Card b&#7855;t &#273;&#7847;u" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="StartCardComboBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  SelectedItem="{Binding Settings.StartCardNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="CardIoComboBox_SelectionChanged"
                                  ToolTip="Card v&#7853;t l&#253; ch&#7913;a logical IO1; c&#225;c card ph&#237;a tr&#432;&#7899;c kh&#244;ng tham gia test"/>

                        <TextBlock Grid.Row="2" Text="T&#7893;ng I/O" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock x:Name="TotalIoCapacityText"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   ToolTip="T&#7921; t&#237;nh: s&#7889; card m&#7903; r&#7897;ng &#215; 64 IO"/>

                        <TextBlock Grid.Row="3" Text="X&#225;c nh&#7853;n IO1" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="IoConfirm1ComboBox" Grid.Row="3" Grid.Column="1" SelectedItem="{Binding Settings.IoConfirm1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Text="X&#225;c nh&#7853;n IOn" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="IoConfirmNComboBox" Grid.Row="4" Grid.Column="1" SelectedItem="{Binding Settings.IoConfirmN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="5" Text="&#272;&#7897; tr&#7877; USB" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.UsbDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="6" Text="LOTNO bắt đầu" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="6"
                                 Grid.Column="1"
                                 Text="{Binding Settings.LotNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="LOTNO của sản phẩm PASS kế tiếp; cùng số này được ghi vào lịch sử test và in trên tem."/>

                        <TextBlock Grid.Row="7" Text="T&#234;n thi&#7871;t b&#7883;" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="8" Text="S&#7889; thi&#7871;t b&#7883;" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Settings.DeviceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="9" Text="C&#244;ng ty" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Settings.OperatorCompany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="10" Text="D&#226;y chuy&#7873;n" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Settings.ProductionLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="11" Text="S&#7889; l&#7895;i Master t&#7889;i thi&#7875;u" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="11"
                                 Grid.Column="1"
                                 Text="{Binding MasterFaultRequiredCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="0 = b&#7887; ki&#7875;m tra Master. 1 tr&#7903; l&#234;n = s&#7889; l&#7895;i Master t&#7889;i thi&#7875;u c&#7847;n x&#225;c nh&#7853;n."/>

                        <TextBlock Grid.Row="12" Text="Board UART COM" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="12" Grid.Column="1"
                                 Text="{Binding Settings.BoardPortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="COM của bo JBZ; để trống để dò. Không dùng COM của máy Leak hoặc máy in."/>

                        <TextBlock Grid.Row="13" Text="T&#7921; l&#432;u l&#7895;i" Style="{StaticResource FieldLabelStyle}"/>
                        <CheckBox Grid.Row="13"
                                  Grid.Column="1"
                                  IsChecked="{Binding Settings.AutoSaveErrors, Mode=TwoWay}"
                                  ToolTip="Chỉ tạo JSON lỗi sản phẩm khi Bật tất cả log hệ thống cũng đang bật."/>

                        <TextBlock Grid.Row="14" Text="Bật tất cả log hệ thống" Style="{StaticResource FieldLabelStyle}"/>
                        <CheckBox Grid.Row="14"
                                  Grid.Column="1"
                                  IsChecked="{Binding Settings.EnableSystemLogs, Mode=TwoWay}"
                                  ToolTip="Tắt: không ghi Data/Logs và Data/ErrorLogs. Data/History vẫn luôn được lưu."/>

                        <TextBlock Grid.Row="15" Text="Model g&#7847;n nh&#7845;t" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="15"
                                 Grid.Column="1"
                                 Text="{Binding Settings.LastThtPath, Mode=OneWay}"
                                 ToolTip="{Binding Settings.LastThtPath, Mode=OneWay}"
                                 IsReadOnly="True"/>

                        <TextBlock Grid.Row="16"
                                   Grid.ColumnSpan="2"
                                   Text="Relay tay dùng trực tiếp • không cần bật hoặc lưu Manual Mode"
                                   Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap"/>

                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="RelaySettingsPanel" Width="370" VerticalAlignment="Top" Style="{StaticResource SettingsPanelStyle}">
                <StackPanel>
                    <TextBlock Text="RELAY / B&#7842;O TR&#204;" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Probe cycle" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="PartCnt.txt"
                                 IsReadOnly="True"
                                 ToolTip="Ngưỡng thay Pin và counter được quản lý theo từng mã hàng trong PartCnt.txt."/>

                        <TextBlock Grid.Row="1" Text="JIG pulse (ms)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Relay1JigPulseMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Text="MARK pulse (ms)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.Relay2MarkingPulseMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="3" Text="PASS MARK - JIG" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.PassMarkingToJigDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Text="Bật mở JIG" Style="{StaticResource FieldLabelStyle}"/>
                        <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding Settings.JigEjectRelayEnabled, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="5" Text="Bật MARKING PASS" Style="{StaticResource FieldLabelStyle}"/>
                        <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding Settings.PassMarkingRelayEnabled, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="6" Text="Relay mở JIG" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="RELAY 1 (OUT0) - cố định" FontWeight="Bold"/>

                        <TextBlock Grid.Row="7" Text="Relay MARKING" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="RELAY 5 (OUT4) - cố định" FontWeight="Bold"/>

                        <TextBlock Grid.Row="8" Text="Resistance delay" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Settings.ResistanceDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="9" Text="Scroll delay (ms)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Settings.ScrollDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    </Grid>

                    <Border x:Name="WaterProofSettingsPanel"
                            Margin="0,8,0,0"
                            Padding="7"
                            Background="#F3F7FF"
                            BorderBrush="#9CADCF"
                            BorderThickness="1"
                            CornerRadius="3">
                        <StackPanel>
                            <TextBlock Text="KIỂM TRA KÍN NƯỚC / TEST LEAK"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding WaterProofModelKey, StringFormat=Model: {0}}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMuted}"
                                           TextTrimming="CharacterEllipsis"/>
                                <CheckBox Grid.Column="1"
                                          Content="BẬT TEST LEAK"
                                          IsChecked="{Binding WaterProof.Enabled, Mode=TwoWay}"
                                          Height="26"
                                          Margin="6,0,0,0"
                                          FontWeight="Bold"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="68"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="96"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="COM RS232" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="WaterProofComComboBox"
                                          Grid.Column="1"
                                          Height="28"
                                          IsEditable="True"
                                          Text="{Binding Settings.WaterProofMachine.PortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="2"
                                        Content="LÀM MỚI"
                                        Height="28"
                                        Margin="3,2,0,2"
                                        FontSize="9.5"
                                        Padding="1,0"
                                        Style="{StaticResource SettingsInfoButtonStyle}"
                                        Click="RefreshWaterProofPorts_Click"/>

                                <TextBlock Grid.Row="1" Text="Test máy Leak" Style="{StaticResource FieldLabelStyle}"/>
                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Height="30"
                                        Margin="0,2,0,2"
                                        Content="CHẠY TEST"
                                        Command="{Binding ManualWaterProofTestCommand}"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        ToolTip="Chạy thử máy Leak bằng COM và thông số đang chọn; không tăng sản lượng và không chạy relay."/>

                                <TextBlock Grid.Row="2"
                                           Text="Kênh / Connector"
                                           VerticalAlignment="Top"
                                           Margin="0,8,7,0"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <Grid x:Name="WaterProofChannelRows"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Content="CH1" Height="28" IsChecked="{Binding WaterProof.Channel1Enabled, Mode=TwoWay}"/>
                                    <ComboBox Grid.Column="1" Height="28" Margin="2,2,0,2" IsEditable="True"
                                              ItemsSource="{Binding WaterProofConnectorOptions}"
                                              Text="{Binding WaterProof.Channel1Connector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Grid.Row="1" Content="CH2" Height="28" IsChecked="{Binding WaterProof.Channel2Enabled, Mode=TwoWay}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" Height="28" Margin="2,2,0,2" IsEditable="True"
                                              ItemsSource="{Binding WaterProofConnectorOptions}"
                                              Text="{Binding WaterProof.Channel2Connector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Grid.Row="2" Content="CH3" Height="28" IsChecked="{Binding WaterProof.Channel3Enabled, Mode=TwoWay}"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" Height="28" Margin="2,2,0,2" IsEditable="True"
                                              ItemsSource="{Binding WaterProofConnectorOptions}"
                                              Text="{Binding WaterProof.Channel3Connector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <TextBlock Grid.Row="3" Text="Áp tối thiểu" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Height="28"
                                         Text="{Binding WaterProof.PressMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="4" Text="Độ rò tối đa" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Height="28"
                                         Text="{Binding WaterProof.LeakLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="5" Text="Tạo / Giữ áp (ms)" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Height="28" Text="{Binding WaterProof.PressTimeMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Height="28" Text="{Binding WaterProof.WaitTimeMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <TextBlock Grid.Row="6"
                                           Grid.ColumnSpan="3"
                                           Margin="0,5,0,1"
                                           Text="{Binding ManualWaterProofStatus}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrandBlue}"
                                           TextWrapping="Wrap"/>

                                <ItemsControl Grid.Row="7"
                                              Grid.ColumnSpan="3"
                                              Margin="0,4,0,0"
                                              ItemsSource="{Binding ManualWaterProofResults}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ManualLeakResultCard"
                                                    Margin="2"
                                                    Padding="5"
                                                    MinHeight="88"
                                                    Background="{Binding LiveCellBackground}"
                                                    BorderBrush="#9CADCF"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ChannelText}"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding LiveCellForeground}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding LiveMachineValueText}"
                                                               HorizontalAlignment="Center"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding LiveCellForeground}"/>
                                                    <TextBlock Text="{Binding LeakText, StringFormat=Độ rò: {0}}"
                                                               HorizontalAlignment="Center"
                                                               FontSize="10.5"
                                                               Foreground="{Binding LiveCellForeground}"/>
                                                    <TextBlock x:Name="ManualLeakResultText"
                                                               Text="{Binding ResultText}"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding LiveCellForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                    <Setter TargetName="ManualLeakResultCard" Property="Background" Value="#ECEFF1"/>
                                                    <Setter TargetName="ManualLeakResultText" Property="Text" Value="TẮT"/>
                                                    <Setter TargetName="ManualLeakResultText" Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManualPanelVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="MANUAL RELAY BO MỚI" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Margin="0,0,0,4"
                                   Text="Chỉ 2 relay vật lý: RELAY 1 = OUT0 và RELAY 5 = OUT4. OUT1/OUT2/OUT3 không phải relay."
                                   Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="RELAY 1 (OUT0)" Style="{StaticResource FieldLabelStyle}"/>
                            <Button Grid.Column="1" Content="BẬT" Command="{Binding ManualRelay0OnCommand}" Style="{StaticResource SettingsWarningButtonStyle}"/>
                            <Button Grid.Column="2" Content="TẮT" Command="{Binding ManualResetCommand}" Style="{StaticResource SettingsExitButtonStyle}"/>
                            <TextBlock Grid.Column="3" Text="{Binding ManualRelay0Status}" FontWeight="Bold" HorizontalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Text="RELAY 5 (OUT4)" Style="{StaticResource FieldLabelStyle}"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="BẬT" Command="{Binding ManualRelay4OnCommand}" Style="{StaticResource SettingsWarningButtonStyle}"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="TẮT" Command="{Binding ManualResetCommand}" Style="{StaticResource SettingsExitButtonStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ManualRelay4Status}" FontWeight="Bold" HorizontalAlignment="Center"/>

                            <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Content="TẮT CẢ 2 RELAY"
                                    Command="{Binding ManualResetCommand}" Style="{StaticResource SettingsExitButtonStyle}"/>

                            <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Text="{Binding ManualStatus}"
                                       Foreground="{StaticResource TextMuted}" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="LabelSettingsPanel" Width="540" VerticalAlignment="Top" Style="{StaticResource SettingsPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="TEM / &#272;I&#7878;N TR&#7902;" Style="{StaticResource SectionTitleStyle}"/>

                    <Grid x:Name="LabelPrintSettingsForm" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Cổng in" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="PrinterComComboBox"
                                  Grid.Column="1"
                                  Margin="0,2,4,2"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="PortName"
                                  SelectedValue="{Binding Settings.Label.PrinterCom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="PrinterComComboBox_SelectionChanged"/>
                        <Button Grid.Column="2"
                                Height="28"
                                Margin="0,2,4,2"
                                Content="QUÉT"
                                FontSize="11"
                                Padding="2,0"
                                Style="{StaticResource SettingsInfoButtonStyle}"
                                Click="RefreshPrinterPorts_Click"/>

                        <TextBlock Grid.Column="3"
                                   Margin="5,0,4,0"
                                   Text="Loại tem"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox Grid.Column="4"
                                  Grid.ColumnSpan="2"
                                  Width="115"
                                  HorizontalAlignment="Left"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding Settings.Label.TemplateType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="TEM TO" Tag="TEM_TO"/>
                            <ComboBoxItem Content="TEM BÉ" Tag="TEM_BE"/>
                            <ComboBoxItem Content="TEM BÉ QR" Tag="TEM_BE_QR"/>
                        </ComboBox>

                        <CheckBox Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Content="Sử dụng in Lable"
                                  IsChecked="{Binding Settings.AutoPrintLabelOnPass, Mode=TwoWay}"/>

                        <UniformGrid x:Name="LabelPrintActionsPanel"
                                     Grid.Row="2"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="6"
                                     Columns="3"
                                     Width="252"
                                     HorizontalAlignment="Right">
                            <Button Content="CH&#7880;NH TEM" Height="28" Margin="2,2" Padding="3,0"
                                    Style="{StaticResource SettingsInfoButtonStyle}" Click="EditLabelTemplate_Click"/>
                            <Button Content="XEM TR&#431;&#7898;C" Height="28" Margin="2,2" Padding="3,0"
                                    Style="{StaticResource SettingsInfoButtonStyle}" Click="PreviewLabel_Click"/>
                            <Button Content="IN TH&#7916;" Height="28" Margin="2,2" Padding="3,0"
                                    Style="{StaticResource SettingsWarningButtonStyle}" Click="TestPrintLabel_Click"/>
                        </UniformGrid>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,3,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="B&#7852;T" Style="{StaticResource MiniHeaderStyle}"/>
                        <TextBlock Grid.Column="2" Text="K&#202;NH" Style="{StaticResource MiniHeaderStyle}"/>
                        <TextBlock Grid.Column="3" Text="MIN &#937;" Style="{StaticResource MiniHeaderStyle}"/>
                        <TextBlock Grid.Column="4" Text="MAX &#937;" Style="{StaticResource MiniHeaderStyle}"/>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ItemsControl Grid.Row="0" ItemsSource="{Binding ResistanceChannels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="{StaticResource BrandBlue}"/>
                                            <CheckBox Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding DataContext.ChannelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      DisplayMemberPath="Display"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding ChannelSelection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Column="3" Margin="5,2,0,2" Text="{Binding MinOhm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Column="4" Margin="5,2,0,2" Text="{Binding MaxOhm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="1"
                                Margin="0,6,0,0"
                                Padding="6"
                                Background="#F3F7FF"
                                BorderBrush="#9CADCF"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="130"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="ĐO ĐIỆN TRỞ BẰNG TAY"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Margin="0,0,0,3"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding ManualResistanceOptions}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedManualResistanceChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="TẤT CẢ đo các dòng R đang tích BẬT; chọn CH để đo riêng kênh vật lý đó."/>
                                    <Button Grid.Column="1"
                                            Height="30"
                                            Margin="6,2,0,2"
                                            Padding="4,0"
                                            Content="CHẠY ĐO"
                                            Command="{Binding ManualMeasureResistanceCommand}"
                                            Style="{StaticResource SettingsActionButtonStyle}"/>
                                </Grid>

                                <TextBlock Grid.Row="2"
                                           Text="{Binding ManualResistanceStatus}"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrandBlue}"
                                           TextWrapping="Wrap"/>

                                <DataGrid Grid.Row="3"
                                          ItemsSource="{Binding ManualResistanceResults}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#D8DEE9"
                                          AlternatingRowBackground="#F4F7FC"
                                          RowHeight="27"
                                          ColumnHeaderHeight="29"
                                          FontSize="12"
                                          FontWeight="SemiBold"
                                          SelectionMode="Single"
                                          EnableRowVirtualization="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="R" Binding="{Binding Name}" Width="48"/>
                                        <DataGridTextColumn Header="KÊNH" Binding="{Binding ChannelText}" Width="58"/>
                                        <DataGridTextColumn Header="GIÁ TRỊ ĐO" Binding="{Binding Display}" Width="1.35*"/>
                                        <DataGridTextColumn Header="MIN" Binding="{Binding MinDisplayText}" Width="*"/>
                                        <DataGridTextColumn Header="MAX" Binding="{Binding MaxDisplayText}" Width="*"/>
                                        <DataGridTextColumn Header="MẪU" Binding="{Binding SampleCount}" Width="54"/>
                                        <DataGridTextColumn Header="ỔN ĐỊNH (ms)" Binding="{Binding StabilizationTimeMs}" Width="94"/>
                                        <DataGridTemplateColumn Header="KẾT QUẢ" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ResultBadge"
                                                            Margin="5,4"
                                                            Padding="5,1"
                                                            CornerRadius="3"
                                                            Background="#E7EBF3">
                                                        <TextBlock x:Name="ResultTextBlock"
                                                                   Text="{Binding ResultText}"
                                                                   HorizontalAlignment="Center"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextMuted}"/>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding ResultText}" Value="PASS">
                                                            <Setter TargetName="ResultBadge" Property="Background" Value="{StaticResource PassGreen}"/>
                                                            <Setter TargetName="ResultTextBlock" Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ResultText}" Value="FAIL">
                                                            <Setter TargetName="ResultBadge" Property="Background" Value="{StaticResource FailRed}"/>
                                                            <Setter TargetName="ResultTextBlock" Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ResultText}" Value="UNSTABLE">
                                                            <Setter TargetName="ResultBadge" Property="Background" Value="{StaticResource PendingAmber}"/>
                                                            <Setter TargetName="ResultTextBlock" Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ResultText}" Value="ĐANG ĐO">
                                                            <Setter TargetName="ResultBadge" Property="Background" Value="{StaticResource PendingAmber}"/>
                                                            <Setter TargetName="ResultTextBlock" Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </WrapPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid Margin="10,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Width="190"
                            Content="L&#431;U"
                            Click="Save_Click"
                            Style="{StaticResource SettingsPrimaryButtonStyle}"/>
                    <Button Width="150" Content="TR&#7902; V&#7872;" FontWeight="Bold" Click="Cancel_Click"
                            Style="{StaticResource SettingsExitButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
