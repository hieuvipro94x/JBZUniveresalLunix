<Window x:Class="JBZUniveresalLunix.Views.JbzPartSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NHẬP MÃ HÀNG"
        Width="430" Height="125"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White"
        Closing="Window_Closing"
        FocusManager.FocusedElement="{Binding ElementName=PartBox}">
    <Grid Margin="20">
        <TextBox x:Name="PartBox"
                 Height="44"
                 FontSize="21"
                 FontWeight="SemiBold"
                 Padding="10,5"
                 VerticalContentAlignment="Center"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Center"
                 KeyDown="PartBox_KeyDown"/>
    </Grid>
</Window>
