<Window x:Class="JBZUniveresalLunix.Views.JbzPartSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NHẬP MÃ HÀNG"
        Width="430" Height="175"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White"
        Closing="Window_Closing"
        FocusManager.FocusedElement="{Binding ElementName=PartBox}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="PartBox"
                 Grid.Row="0"
                 Height="44"
                 FontSize="21"
                 FontWeight="SemiBold"
                 Padding="10,5"
                 VerticalContentAlignment="Center"
                 HorizontalAlignment="Stretch"
                 KeyDown="PartBox_KeyDown"/>

        <Grid x:Name="ProgressPanel"
              Grid.Row="2"
              Height="32"
              Visibility="Collapsed">
            <ProgressBar x:Name="UploadProgress"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Height="28"
                         VerticalAlignment="Center"/>
            <TextBlock x:Name="PercentText"
                       Text="0%"
                       FontSize="15"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
