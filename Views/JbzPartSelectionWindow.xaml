<Window x:Class="JBZUniveresalLunix.Views.JbzPartSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CHỌN MÃ HÀNG / NẠP MODEL XUỐNG BO"
        Width="570" Height="300" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White"
        Closing="Window_Closing">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Nhập tên mã hàng (ví dụ: 321085)" FontSize="17" FontWeight="SemiBold"/>
        <TextBox x:Name="PartBox" Grid.Row="1" FontSize="19" Padding="8,3"
                 KeyDown="PartBox_KeyDown"/>
        <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="Tự tìm trong Models và Setups; không chọn file thủ công."
                   Foreground="#555"/>
        <TextBlock x:Name="FilesText" Grid.Row="3" Margin="0,8,0,0"
                   TextWrapping="Wrap" Foreground="#555"/>
        <ProgressBar x:Name="UploadProgress" Grid.Row="4" Minimum="0" Maximum="100"
                     Height="22" Margin="0,8,0,0" Value="0"/>
        <TextBlock x:Name="PercentText" Grid.Row="5" Text="0%" TextAlignment="Right"
                   FontWeight="Bold" Foreground="#273F91"/>
        <TextBlock x:Name="StatusText" Grid.Row="6" Margin="0,6,0,0"
                   Text="Chờ nhập mã hàng" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="UploadButton" Content="NẠP XUỐNG BO" Width="155" Height="30"
                    Margin="0,0,8,0" Click="UploadButton_Click"/>
            <Button x:Name="CancelButton" Content="ĐÓNG" Width="90" Height="36"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
