<Window x:Class="JBZUniveresalLunix.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UniversalTester - JBZ Production"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">

    <Window.Resources>

        <SolidColorBrush x:Key="PageBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#555555"/>
        <SolidColorBrush x:Key="TextMuted" Color="#777777"/>
        <SolidColorBrush x:Key="BrandBlue" Color="#273F91"/>
        <SolidColorBrush x:Key="HistoryBackground" Color="#E8EDF5"/>
        <SolidColorBrush x:Key="HistoryBorder" Color="#AEBBD2"/>
        <SolidColorBrush x:Key="SettingsBackground" Color="#ECEFF1"/>
        <SolidColorBrush x:Key="SettingsForeground" Color="#455A64"/>
        <SolidColorBrush x:Key="SettingsBorder" Color="#B0BEC5"/>
        <SolidColorBrush x:Key="ModelAction" Color="#B45309"/>
        <SolidColorBrush x:Key="TopologyAction" Color="#0F766E"/>
        <SolidColorBrush x:Key="ExitBackground" Color="#FFF0F0"/>
        <SolidColorBrush x:Key="ExitForeground" Color="#A61B1B"/>
        <SolidColorBrush x:Key="ExitBorder" Color="#D97979"/>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#EFEFEE"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>

                            <!-- Lớp tương tác làm tối chính màu semantic của từng nút,
                                 không thay tất cả button thành cùng một màu xám. -->
                            <Border x:Name="InteractionOverlay"
                                    Background="#000000"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Opacity="0"/>

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay"
                                        Property="Opacity"
                                        Value="0.08"/>
                            </MultiTrigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay"
                                        Property="Opacity"
                                        Value="0.16"/>
                            </MultiTrigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E5E7EB"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="{StaticResource BrandBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E3278"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="HistoryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource HistoryBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HistoryBorder}"/>
        </Style>

        <Style x:Key="SettingsButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource SettingsBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource SettingsForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsBorder}"/>
        </Style>

        <Style x:Key="ModelButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource ModelAction}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#92400E"/>
        </Style>

        <Style x:Key="TopologyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource TopologyAction}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0B5F59"/>
        </Style>

        <Style x:Key="ExitButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource ExitBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ExitForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ExitBorder}"/>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource PageBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- ====================================================== -->
        <!-- HEADER                                                 -->
        <!-- ====================================================== -->

        <Grid Grid.Row="0"
              Margin="20,16,20,0">

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top">

                <TextBlock x:Name="AppVersionText"
                           Text="JBZ Universal"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="15"
                           TextAlignment="Right"/>

                <TextBlock Text="{Binding Test.BoardFirmwareName, Mode=OneWay}"
                           Foreground="{StaticResource BrandBlue}"
                           FontSize="17" FontWeight="SemiBold" TextAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Test.IsBoardIdentityVerified}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>
        </Grid>

        <!-- ====================================================== -->
        <!-- MÀN HÌNH KHỞI ĐỘNG / CHỌN MÃ HÀNG                     -->
        <!-- ====================================================== -->

        <Grid Grid.Row="1">

            <StackPanel Width="1080"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Border Width="220"
                        Background="White"
                        HorizontalAlignment="Center"
                        BorderBrush="#D0D0CE"
                        BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="VINA"
                                   Foreground="{StaticResource BrandBlue}"
                                   FontSize="58"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="16,4"/>

                        <Border Background="{StaticResource BrandBlue}">
                            <TextBlock Text="JBZVINA-2026"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Padding="8,4"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- ====================================================== -->
        <!-- THANH CHỨC NĂNG                                        -->
        <!-- ====================================================== -->

        <Grid x:Name="MainActionBar"
              Grid.Row="2"
              Margin="4,0,4,4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="1.00*"/>
                <ColumnDefinition Width="1.00*"/>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.10*"/>
                <ColumnDefinition Width="1.00*"/>
                <ColumnDefinition Width="0.75*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="StartTestButton"
                    Grid.Column="0"
                    Click="OpenTestWindow_Click"
                    Style="{StaticResource PrimaryButton}"
                    Content="BẮT ĐẦU KIỂM TRA"/>

            <!-- V12.8: bỏ lối vào PinProbeWindow riêng. Đầu dò hoạt động song song
                 trong TestWindow nên người vận hành không cần chuyển chế độ. -->
            <Button Grid.Column="1"
                    Click="OpenHistory_Click"
                    Style="{StaticResource HistoryButtonStyle}"
                    Content="LỊCH SỬ"/>

            <Button Grid.Column="2"
                    Click="OpenSettings_Click"
                    Style="{StaticResource SettingsButtonStyle}"
                    Content="CÀI ĐẶT"/>

            <Button x:Name="SelectModelButton"
                    Grid.Column="3"
                    Command="{Binding Home.LoadModelCommand}"
                    Style="{StaticResource ModelButtonStyle}"
                    Content="CHỌN MÃ HÀNG"/>

            <Button x:Name="LearnTopologyButton"
                    Grid.Column="4"
                    Click="OpenTopologyLearning_Click"
                    Style="{StaticResource TopologyButtonStyle}"
                    Content="QUÉT / HỌC MÃ"/>

            <Button x:Name="BoardMaintenanceButton"
                    Grid.Column="5"
                    Click="OpenBoardMaintenance_Click"
                    Style="{StaticResource SettingsButtonStyle}"
                    Content="BẢO TRÌ BO"/>

            <Button Grid.Column="6"
                    Command="{Binding ExitCommand}"
                    Style="{StaticResource ExitButtonStyle}"
                    Content="KẾT THÚC"/>
        </Grid>

        <Border x:Name="ProductRemovalNotice"
                Grid.Row="1"
                Panel.ZIndex="10"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="36,22"
                Background="#FFF2A8"
                BorderBrush="#C89000"
                BorderThickness="2"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="VUI LÒNG THÁO SẢN PHẨM"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#8A3B00"
                           TextAlignment="Center"/>
                <TextBlock Text="Chọn mã hàng đang bị khóa. Bạn vẫn có thể mở màn hình kiểm tra để theo dõi; thông báo sẽ tự mất khi sản phẩm đã được tháo hoàn toàn."
                           Margin="0,8,0,0"
                           FontSize="15"
                           Foreground="#5C4200"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    

        <!-- ====================================================== -->
        <!-- V12.9 - SINGLE WINDOW INTERNAL PAGE HOST               -->
        <!-- Cài đặt/Lịch sử được nhúng trong MainWindow, không     -->
        <!-- tạo Window/ShowDialog nên không sinh thêm Alt+Tab.      -->
        <!-- ====================================================== -->
        <ContentControl x:Name="InternalPageHost"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Panel.ZIndex="20"
                        Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="#F3F4F6"/>

</Grid>
</Window>
