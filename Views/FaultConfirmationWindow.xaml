<Window x:Class="JBZUniveresalLunix.Views.FaultConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sản phẩm không đạt"
        Width="500"
        MinHeight="260"
        MaxHeight="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6"
        FontFamily="Arial"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#C62828">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="28" Height="28"
                        Margin="0,0,10,0"
                        CornerRadius="14"
                        Background="White">
                    <TextBlock Text="!"
                               Foreground="#C62828"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"/>
                </Border>
                <TextBlock x:Name="WindowHeaderText"
                           Text="SẢN PHẨM KHÔNG ĐẠT"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontSize="21"
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="14,12,14,10"
                Padding="18,14"
                Background="White"
                BorderBrush="#E1E4E8"
                BorderThickness="1"
                CornerRadius="7">
            <StackPanel>
                <TextBlock x:Name="FaultTypeText"
                           Foreground="#B91C1C"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="20"
                           FontWeight="Bold"/>

                <Border Height="2"
                        Margin="72,10,72,10"
                        Background="#F1B8B8"/>

                <TextBlock x:Name="SummaryText"
                           Foreground="#20242A"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="18"
                           FontWeight="SemiBold"
                           LineHeight="26"
                           MaxWidth="440"/>

                <ItemsControl x:Name="FaultItemsControl"
                              Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="#E9EBEF"
                BorderBrush="#D7DADE"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="DiscardPasswordPanel"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,8"
                            Visibility="Collapsed">
                    <TextBlock Text="NHẬP MẬT KHẨU XỬ LÝ HÀNG LỖI"
                               FontWeight="Bold" Foreground="#991B1B"/>
                    <PasswordBox x:Name="DiscardPasswordBox"
                                 Height="36" Margin="0,5,0,0"
                                 Padding="7,3" FontSize="16"/>
                    <TextBlock x:Name="DiscardPasswordErrorText"
                               Margin="0,4,0,0" Foreground="#B91C1C"
                               FontWeight="SemiBold" Visibility="Collapsed"/>
                </StackPanel>

                <TextBlock x:Name="FooterText"
                           Grid.Row="1"
                           Margin="0,0,14,0"
                           Foreground="#4B5563"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="13"
                           FontWeight="SemiBold"
                           MaxWidth="320"/>

                <Button Grid.Row="1"
                        Grid.Column="1"
                        Width="110"
                        Height="42"
                        Content="XÁC NHẬN"
                        FontSize="14"
                        FontWeight="Bold"
                        IsDefault="True"
                        Background="#C62828"
                        Foreground="White"
                        BorderBrush="#9F1F1F"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Confirm_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
