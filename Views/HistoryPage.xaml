<UserControl x:Class="JBZUniversalTester.Views.HistoryPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#EEF1F4"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
    PreviewKeyDown="Page_PreviewKeyDown">

    <UserControl.Resources>
        <SolidColorBrush x:Key="HistoryBrandBlue" Color="#273F91"/>
        <SolidColorBrush x:Key="HistoryNeutralBackground" Color="#ECEFF1"/>
        <SolidColorBrush x:Key="HistoryNeutralForeground" Color="#455A64"/>
        <SolidColorBrush x:Key="HistoryNeutralBorder" Color="#B0BEC5"/>
        <SolidColorBrush x:Key="HistoryExportLightBackground" Color="#E5F5F3"/>
        <SolidColorBrush x:Key="HistoryExportAction" Color="#0F766E"/>
        <SolidColorBrush x:Key="HistoryExitBackground" Color="#FFF0F0"/>
        <SolidColorBrush x:Key="HistoryExitForeground" Color="#A61B1B"/>
        <SolidColorBrush x:Key="HistoryExitBorder" Color="#D97979"/>

        <Style x:Key="CompactButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource HistoryNeutralBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource HistoryNeutralForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HistoryNeutralBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Border x:Name="InteractionOverlay"
                                    Background="#000000"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Opacity="0"/>
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.08"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.16"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E5E7EB"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryCsvButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CompactButton}">
            <Setter Property="Background" Value="{StaticResource HistoryExportLightBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource HistoryExportAction}"/>
            <Setter Property="BorderBrush" Value="#86C8C1"/>
        </Style>

        <Style x:Key="HistoryExcelButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CompactButton}">
            <Setter Property="Background" Value="{StaticResource HistoryExportAction}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0B5F59"/>
        </Style>

        <Style x:Key="HistorySearchButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CompactButton}">
            <Setter Property="Background" Value="{StaticResource HistoryBrandBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E3278"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="HistoryCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CompactButton}">
            <Setter Property="Background" Value="{StaticResource HistoryExitBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource HistoryExitForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HistoryExitBorder}"/>
        </Style>

        <Style x:Key="FilterTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FilterDatePicker"
               TargetType="DatePicker">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FilterComboBox"
               TargetType="ComboBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5B6470"/>
            <Setter Property="Margin" Value="1,0,0,3"/>
        </Style>

        <Style x:Key="HistoryHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Background" Value="#E8EDF3"/>
            <Setter Property="Foreground" Value="#293241"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C8D0D9"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CenterCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HistoryCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEBFA"/>
                    <Setter Property="Foreground" Value="#172B3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#B8C2CC"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10,6"
                MinHeight="56"
                Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="430"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="LỊCH SỬ KIỂM TRA"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#243447"/>
                    <TextBlock Text="Tra cứu nhanh, xem dữ liệu tem và xuất Excel theo mẫu chuẩn"
                               FontSize="10.5"
                               Foreground="#7A8490"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#F2F5F8" CornerRadius="3" Margin="3,0" Padding="7,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TỔNG" FontSize="9.5" Foreground="#69737D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TotalCountText" Text="0" FontSize="17" FontWeight="Bold" Foreground="#22313F" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#EEF8F1" CornerRadius="3" Margin="3,0" Padding="7,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="PASS" FontSize="9.5" Foreground="#3E6D4D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PassCountText" Text="0" FontSize="17" FontWeight="Bold" Foreground="#16813A" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#FFF0F0" CornerRadius="3" Margin="3,0" Padding="7,3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="FAIL" FontSize="9.5" Foreground="#8A4B4B" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FailCountText" Text="0" FontSize="17" FontWeight="Bold" Foreground="#C62828" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="0">
                    <Button Content="CSV"
                            Width="78"
                            Style="{StaticResource HistoryCsvButtonStyle}"
                            Click="ExportCsv_Click"/>
                    <Button Content="XUẤT EXCEL"
                            Width="112"
                            Style="{StaticResource HistoryExcelButtonStyle}"
                            Click="ExportXlsx_Click"/>
                    <Button x:Name="CloseButton"
                            Content="ĐÓNG"
                            Width="78"
                            Style="{StaticResource HistoryCloseButtonStyle}"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Compact filters -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#B8C2CC"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8,6"
                MinHeight="62"
                Margin="0,0,0,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
            <Grid MinWidth="1200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="142"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="142"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="106"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="Từ ngày" Style="{StaticResource FilterLabel}"/>
                    <DatePicker x:Name="FromDatePicker" Style="{StaticResource FilterDatePicker}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="Đến ngày" Style="{StaticResource FilterLabel}"/>
                    <DatePicker x:Name="ToDatePicker" Style="{StaticResource FilterDatePicker}"/>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Top">
                    <TextBlock Text="LOTNO" Style="{StaticResource FilterLabel}"/>
                    <TextBox x:Name="LotTextBox" Style="{StaticResource FilterTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Column="6" VerticalAlignment="Top">
                    <TextBlock Text="File THT" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="PartComboBox"
                              Style="{StaticResource FilterComboBox}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Keyword"/>
                </StackPanel>

                <StackPanel Grid.Column="8" VerticalAlignment="Top">
                    <TextBlock Text="Kết quả" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="ResultComboBox"
                              Style="{StaticResource FilterComboBox}"
                              SelectedIndex="0">
                        <ComboBoxItem Content="ALL"/>
                        <ComboBoxItem Content="PASS"/>
                        <ComboBoxItem Content="FAIL"/>
                        <ComboBoxItem Content="DÂY CHƯA KẾT NỐI"/>
                        <ComboBoxItem Content="ĐẤU SAI"/>
                        <ComboBoxItem Content="CHẬP MẠCH"/>
                        <ComboBoxItem Content="ĐIỆN TRỞ KHÔNG ĐẠT"/>
                    </ComboBox>
                </StackPanel>

                <Button Grid.Column="10"
                        Content="TÌM KIẾM"
                        Width="106"
                        Margin="0"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource HistorySearchButtonStyle}"
                        Click="Search_Click"
                        FontWeight="Bold"/>
                <Button Grid.Column="12"
                        Content="XÓA LỌC"
                        Width="92"
                        Margin="0"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource CompactButton}"
                        Click="ClearFilter_Click"/>

                <StackPanel Grid.Column="13" Margin="8,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="Loại kiểm tra" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="InspectionTypeComboBox"
                              Style="{StaticResource FilterComboBox}"
                              SelectedIndex="0">
                        <ComboBoxItem Content="TẤT CẢ" Tag=""/>
                        <ComboBoxItem Content="PRODUCTION" Tag="PRODUCT"/>
                        <ComboBoxItem Content="MASTER ĐẠT" Tag="MASTER_GOOD"/>
                        <ComboBoxItem Content="MASTER LỖI" Tag="MASTER_BAD"/>
                        <ComboBoxItem Content="LEAK RETEST" Tag="LEAK_RETEST"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- History table -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#C8D0D9"
                BorderThickness="1"
                CornerRadius="2">
            <DataGrid x:Name="HistoryGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserResizeColumns="False"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeight="28"
                      ColumnHeaderHeight="36"
                      FontSize="11"
                      Background="White"
                      BorderThickness="0"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      AlternatingRowBackground="#F8FAFC"
                      RowBackground="White"
                      FrozenColumnCount="4"
                      CellStyle="{StaticResource HistoryCellStyle}"
                      ColumnHeaderStyle="{StaticResource HistoryHeaderStyle}"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="#E1E6EB"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Passed}" Value="True">
                                <Setter Property="ToolTip" Value="Kết quả PASS"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- Ngày/Thời gian = thời điểm BẮT ĐẦU TEST (EffectiveTestStartedAt).
                         TestHistoryStore sắp xếp từ cũ đến mới theo timestamp này. -->
                    <DataGridTextColumn Header="Ngày" Binding="{Binding DateText}" Width="100"/>
                    <DataGridTextColumn Header="Thời gian" Binding="{Binding TimeText}" Width="90"/>
                    <DataGridTextColumn Header="File" Binding="{Binding ExportModelFileName}" Width="180"/>
                    <DataGridTextColumn Header="Loại kiểm tra" Binding="{Binding InspectionTypeText}" Width="120"/>
                    <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding PartName}" Width="150"/>
                    <DataGridTextColumn Header="Mã hàng" Binding="{Binding PartNumber}" Width="150"/>
                    <DataGridTextColumn Header="Loại xe" Binding="{Binding VehicleType}" Width="115"/>
                    <DataGridTextColumn Header="LOT" Binding="{Binding ExportLotText}" Width="110"/>
                    <DataGridTextColumn Header="Kết quả" Binding="{Binding ExportResultText}" Width="85" ElementStyle="{StaticResource CenterCellText}"/>
                    <DataGridTextColumn Header="Số thứ tự" Binding="{Binding ExportSequenceNo}" Width="100" ElementStyle="{StaticResource CenterCellText}"/>
                    <DataGridTemplateColumn Header="Lịch sử kiểm tra" Width="1200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ExportTestLogText}"
                                           ToolTip="{Binding ExportTestLogText}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Mã vạch" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ExportBarcodeText}"
                                           ToolTip="{Binding ExportBarcodeText}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="200 %" Binding="{Binding ExportPercentText}" Width="80"/>
                    <DataGridTextColumn Header="Kiểm tra đầu vào" Binding="{Binding ExportIncomingInspectionText}" Width="130"/>
                    <DataGridTextColumn Header="Chương trình" Binding="{Binding HtdrvName}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="3" Margin="2,4,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#66717C"
                       FontSize="10.5"
                       TextTrimming="CharacterEllipsis"/>

            <Button x:Name="LoadMoreButton"
                    Grid.Column="1"
                    Content="TẢI THÊM"
                    Height="24"
                    Style="{StaticResource CompactButton}"
                    Click="LoadMore_Click"/>

            <TextBlock Grid.Column="2"
                       Text="Enter: tìm kiếm  •  Có thể kéo giãn và sắp xếp cột"
                       VerticalAlignment="Center"
                       Foreground="#9098A1"
                       FontSize="10"
                       Margin="12,0,2,0"/>
        </Grid>
    </Grid>
</UserControl>
