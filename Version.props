<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    JBZUniversalTester - SINGLE SOURCE OF TRUTH FOR VERSIONING

    QUY TAC BAT BUOC:
    - Moi lan sua source va phat hanh mot ban moi: tang VersionPrefix.
    - Dong thoi cap nhat AssemblyVersion/FileVersion theo cung version.
    - VersionFileTag duoc giu dong bo cho packaging/metadata; runtime EXE co ten on dinh.

    Vi du lan sau:
      12.10.2 -> next release
      AssemblyVersion 12.10.2.0 -> next release
      FileVersion     12.10.2.0 -> next release
      VersionFileTag  12_10_2 -> next release
  -->
  <PropertyGroup>
    <VersionPrefix>16.0.330</VersionPrefix>
    <Version>16.0.330</Version>
    <AssemblyVersion>16.0.330.0</AssemblyVersion>
    <FileVersion>16.0.330.0</FileVersion>
    <InformationalVersion>16.0.330</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <VersionFileTag>16_0_330</VersionFileTag>
    <Product>JBZUniversalTester</Product>
    <AssemblyTitle>JBZUniversalTester V16.0.330</AssemblyTitle>
    <Description>JBZ Universal Tester - Production Harness Tester</Description>
    <Company>JBZ</Company>
    <Copyright>Copyright ??????????????????렞??????猷뱀삌????怨????????????JBZ 2026</Copyright>
  </PropertyGroup>
</Project>
